{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freqtrade Command Center",
  "version": "0.1.0",
  "identifier": "com.freqtradecommandcenter.app",
  "build": {
    "frontendDist": "https://freqpanda.com"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Freqtrade Command Center",
        "url": "https://freqpanda.com/login",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
