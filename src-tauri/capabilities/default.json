{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window: read access to the app's own local data dir only, where trained models are written before upload.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-train-local-model",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPLOCALDATA/**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPLOCALDATA/**" }]
    },
    "updater:default",
    "dialog:default"
  ]
}
