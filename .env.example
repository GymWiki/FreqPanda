# --- App ---
# Baked into every deployed bot's cloud-init as its status-webhook and
# training-callback base URL (see lib/hetzner.ts, lib/train-cloud.ts) and
# into Stripe's checkout success/cancel URLs (app/api/deploy) — this MUST
# match the domain the app is actually reachable at in each environment,
# or already-deployed bots/training VMs will call back to the wrong host.
# Local dev: keep as-is. Production (Vercel): set to the real custom
# domain, e.g. "https://freqpanda.com" — not the *.vercel.app URL, once
# the custom domain is live.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (project: Trading-platform) ---
# Auth + Postgres. The anon/publishable key is safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL="https://uvivzuumvdbnvgmcbbwj.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV2aXZ6dXVtdmRibnZnbWNiYndqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU1NTg5MzgsImV4cCI6MjEwMTEzNDkzOH0.FCooxlEAwc1SpZ0CbINdxMzJvl9LsDG3Kt-Ai8Ndsus"
# Secret — Dashboard → Settings → API → service_role. Only used server-side
# (app/api/train/cloud/upload-url) to mint a signed Storage upload URL for
# the ephemeral training VM, which has no user session/JWT of its own.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Database (Supabase Postgres, accessed via Prisma) ---
# Pooled (Supavisor, port 6543) — used by the app at runtime. pgbouncer=true
# disables prepared statement caching, which the pooler doesn't support.
DATABASE_URL="postgresql://postgres.uvivzuumvdbnvgmcbbwj:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — used by `prisma db push` / `prisma migrate` only.
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.uvivzuumvdbnvgmcbbwj.supabase.co:5432/postgres"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Recurring "per bot" price (quantity-based subscription line item)
STRIPE_VPS_BOT_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Hetzner Cloud ---
HETZNER_API_TOKEN=""
HETZNER_SSH_KEY_ID=""
HETZNER_SERVER_TYPE="cx11"
# Bigger/pricier instance used only for ephemeral FreqAI cloud training runs.
HETZNER_TRAINING_SERVER_TYPE="cpx31"
HETZNER_LOCATION="nbg1"
HETZNER_IMAGE="ubuntu-24.04"

# --- Encryption (AES-256-GCM key for exchange API secrets) ---
# generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Cron auth (GET/POST /api/train/cloud/reap, GET /api/bots/sleep-sweep,
# GET/POST /api/data/refresh) ---
# Triggered by an external scheduler (e.g. cron-job.org — every ~15 min for
# reap, once daily for sleep-sweep and data/refresh), not Vercel Cron.
# Configure that scheduler to send this exact header:
#   Authorization: Bearer <this value>
# generate with: openssl rand -hex 32
CRON_SECRET=""
# How many minutes a training job can sit with no real progress (still
# QUEUED/BOOTED/PULLING_IMAGE/UPLOADING) before GET /api/train/cloud/reap
# marks it FAILED and deletes its Hetzner server. Optional — defaults to
# 20 if unset. DOWNLOADING_DATA has its own, much longer budget below —
# an auto-select bot's download-data call uses freqtrade's own wildcard
# ".*/USDT" (every active USDT pair on the exchange, not just the ~30 a
# live/dry-run instance actually trades), which can legitimately take
# over an hour.
TRAINING_QUEUE_TIMEOUT_MINUTES="20"
DOWNLOAD_DATA_QUEUE_TIMEOUT_MINUTES="120"

# --- Telegram notifications (optional) ---
# One central bot for every user, distinguished by which chat_id it's
# telling to notify (see Profile.telegramChatId, app/settings). Injected
# into each deployed bot's config.json — freqtrade's own built-in telegram
# integration does the actual notifying, no send-side code of ours needed.
# Get a token from https://t.me/BotFather. Leave both unset to skip the
# feature entirely — a bot deploys fine without it.
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Desktop app download links: no env vars needed — the landing page's
# download buttons hit /api/download?platform=windows|mac, which resolves
# against whatever GitHub Release is currently published (see
# app/api/download/route.ts and .github/workflows/release-desktop-app.yml).
